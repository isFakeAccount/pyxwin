{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "download with args",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "pyxwin_cli",
            "console": "integratedTerminal",
            "args": [
                "wincrt",
                "--cache-dir",
                "${workspaceFolder}/.pyxwin-cache",
                "--manifest-version",
                "18",
                "--channel",
                "stable",
                "download",
            ],
            "justMyCode": false,
            "env": {
                "PYXWIN_ACCEPT_LICENSE": "1"
            }
        },
        {
            "name": "unpack with args",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "pyxwin_cli",
            "console": "integratedTerminal",
            "args": [
                "wincrt",
                "--cache-dir",
                "${workspaceFolder}/.pyxwin-cache",
                "--manifest-version",
                "18",
                "--channel",
                "stable",
                "unpack",
            ],
            "justMyCode": false,
            "env": {
                "PYXWIN_ACCEPT_LICENSE": "1"
            }
        },
        {
            "name": "reduce with args",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "pyxwin_cli",
            "console": "integratedTerminal",
            "args": [
                "wincrt",
                "--cache-dir",
                "${workspaceFolder}/.pyxwin-cache",
                "--manifest-version",
                "18",
                "--channel",
                "stable",
                "--workloads",
                "Microsoft.VisualStudio.Workload.NativeDesktop",
                "--workloads",
                "Microsoft.VisualStudio.Workload.VCTools",
                "--workloads",
                "Microsoft.VisualStudio.Workload.NativeGame",
                "--workloads",
                "Microsoft.VisualStudio.Workload.NativeCrossPlat",
                "--workloads",
                "Microsoft.VisualStudio.Workload.NativeMobile",
                "--workloads",
                "Microsoft.VisualStudio.Workload.Azure",
                "--workloads",
                "Microsoft.VisualStudio.Workload.AzureBuildTools",
                "--workloads",
                "Microsoft.VisualStudio.Workload.Data",
                "--workloads",
                "Microsoft.VisualStudio.Workload.DataBuildTools",
                "--workloads",
                "Microsoft.VisualStudio.Workload.ManagedGame",
                "reduce",
            ],
            "justMyCode": false,
            "env": {
                "PYXWIN_ACCEPT_LICENSE": "1"
            }
        },
        {
            "name": "interactive",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "module": "pyxwin_cli",
            "console": "integratedTerminal",
            "args": [
                "wincrt",
                "--cache-dir",
                "${workspaceFolder}/.pyxwin-cache",
                "interactive",
            ],
            "justMyCode": false,
            "env": {
                "PYXWIN_ACCEPT_LICENSE": "1"
            }
        }
    ]
}